@page "/mock-exam"
@using StudyVera.FrontEnd.Models.Lessons
@using StudyVera.FrontEnd.Models.Mocks
@using StudyVera.FrontEnd.Services.Concrats
@inject IUserMockExamService MockService
@inject IJSRuntime JS
@inject ILessonService LessonService

<div class="container-fluid p-4" style="min-height: 90vh;">
    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card shadow border-0" style="border-radius: 15px;">
                <div class="card-header bg-primary text-white p-3" style="border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Yeni Deneme Kaydı</h5>
                </div>
                <div class="card-body bg-card-custom">
                    <EditForm Model="newExam" OnValidSubmit="HandleCreateExam">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Deneme Bilgileri</label>
                            
                            <!-- YENİ ÖZELLİK: Anlık Özet Kartı -->
                            <div class="d-flex justify-content-between align-items-center bg-light-subtle p-2 rounded mb-2 border border-opacity-25 border-primary">
                                <div class="text-center">
                                    <span class="d-block small text-muted fw-bold">D / Y</span>
                                    <span class="fw-bold text-dark">@newExam.Details.Sum(x=>x.CorrectCount) / @newExam.Details.Sum(x=>x.WrongCount)</span>
                                </div>
                                <div class="vr"></div>
                                <div class="text-center">
                                    <span class="d-block small text-muted fw-bold">Tahmini Net</span>
                                    <span class="fw-bold text-primary fs-5">@CalculateEstimatedNet().ToString("N2")</span>
                                </div>
                            </div>

                            <div class="input-group mb-2 shadow-sm">
                                <span class="input-group-text border-0"><i class="bi bi-book"></i></span>
                                <input @bind="newExam.Publisher" class="form-control border-0 bg-input-custom" placeholder="Yayınevi" />
                            </div>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text border-0"><i class="bi bi-bookmark-star"></i></span>
                                <input @bind="newExam.ExamName" class="form-control border-0 bg-input-custom" placeholder="Deneme Adı (Örn: TG-1)" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label text-muted small">Tarih</label>
                                <input type="date" @bind="newExam.ExamDate" class="form-control border-0 shadow-sm bg-input-custom" />
                            </div>
                        </div>

                        <hr />

                        <div class="table-responsive rounded border shadow-sm" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="sticky-top bg-light-subtle">
                                    <tr class="small text-muted">
                                        <th class="ps-3">Ders</th>
                                        <th class="text-center" style="width: 90px;">Doğru</th>
                                        <th class="text-center" style="width: 90px;">Yanlış</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in newExam.Details)
                                    {
                                        var lesson = availableLessons.FirstOrDefault(x => x.Id == detail.LessonId);
                                        var limit = lesson?.ExamQuestionCount ?? 0;
                                        var isOverLimit = (detail.CorrectCount + detail.WrongCount) > limit;

                                        <tr class="@(isOverLimit ? "bg-danger bg-opacity-10" : "")">
                                            <td class="ps-3 small fw-bold">
                                                @GetLessonName(detail.LessonId)
                                                @if (isOverLimit)
                                                {
                                                    <div class="text-danger fw-bold" style="font-size: 0.7rem;">
                                                        <i class="bi bi-exclamation-triangle-fill"></i> Max: @limit
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <input type="number" @bind="detail.CorrectCount" @bind:event="oninput"
                                                       min="0"
                                                       class="form-control form-control-sm border-0 text-center bg-input-custom @(isOverLimit ? "is-invalid text-danger fw-bold" : "")" />
                                            </td>
                                            <td>
                                                <input type="number"
                                                       @bind="detail.WrongCount" @bind:event="oninput"
                                                       min="0"    
                                                       class="form-control form-control-sm border-0 text-center bg-input-custom @(isOverLimit ? "is-invalid text-danger fw-bold" : "")" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4 py-2 fw-bold shadow">
                            <i class="bi bi-check-all me-2"></i>Sisteme Kaydet
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow border-0 h-100" style="border-radius: 15px;">
                <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-clock-history me-2"></i>Deneme Geçmişi</h5>
                    <span class="small text-muted d-none d-md-inline">Detaylar için çift tıklayın</span>
                </div>
                <div class="card-body p-0">
                    <!-- YENİ ÖZELLİK: Grafik Alanı -->
                    <div class="p-3 border-bottom bg-body-tertiary" style="height: 260px; position: relative;">
                        <h6 class="text-muted small fw-bold ms-2 mb-2">NET GELİŞİM GRAFİĞİ</h6>
                        <canvas id="netChart"></canvas>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="bg-body-tertiary">
                                <tr class="text-muted small">
                                    <th class="ps-4">Sınav / Yayın</th>
                                    <th>Tarih</th>
                                    <th class="text-center">D / Y</th>
                                    <th class="text-center">Net</th>
                                    <th class="pe-4 text-end">Analiz</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (examHistory == null)
                                {
                                    <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                                }
                                else if (!examHistory.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted small">Henüz veri girişi yapılmamış.</td></tr>
                                }
                                else
                                {
                                    @foreach (var exam in examHistory)
                                    {
                                        <tr @ondblclick="() => ShowDetail(exam.Id)" style="cursor: pointer;">
                                            <td class="ps-4">
                                                <div class="fw-bold">@exam.ExamName</div>
                                                <div class="small text-muted">@exam.Publisher</div>
                                            </td>
                                            <td class="small align-middle opacity-75">@exam.ExamDate.ToShortDateString()</td>
                                            <td class="text-center align-middle">
                                                <span class="badge rounded-pill text-bg-success opacity-75">@exam.TotalCorrect</span>
                                                <span class="badge rounded-pill text-bg-danger opacity-75">@exam.TotalWrong</span>
                                            </td>
                                            <td class="text-center align-middle fw-bold text-primary">@exam.TotalNet.ToString("N2")</td>
                                            <td class="pe-4 text-end align-middle">
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (selectedExamDetail != null)
{
    <div class="modal fade show d-block shadow-lg" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-bottom">
                    <div>
                        <h5 class="modal-title text-primary fw-bold mb-0">@selectedExamDetail.ExamName</h5>
                        <small class="text-muted">Ayrıntılı Performans Analizi</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-md-4">
                            <div class="card border-0 bg-body-tertiary p-3">
                                <div class="small text-muted">Genel Net</div>
                                <div class="h3 mb-0 text-primary fw-bold">@selectedExamDetail.TotalNet.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-8 d-flex align-items-center justify-content-around bg-body-tertiary rounded p-3">
                            <div><div class="small text-muted">Doğru</div><div class="h5 mb-0 text-success">@selectedExamDetail.Details.Sum(x => x.Correct)</div></div>
                            <div class="vr mx-2"></div>
                            <div><div class="small text-muted">Yanlış</div><div class="h5 mb-0 text-danger">@selectedExamDetail.Details.Sum(x => x.Wrong)</div></div>
                            <div class="vr mx-2"></div>
                            <div><div class="small text-muted">Boş</div><div class="h5 mb-0 text-warning">@selectedExamDetail.Details.Sum(x => x.Empty)</div></div>
                        </div>
                    </div>

                    <div class="table-responsive rounded border">
                        <table class="table table-hover mb-0">
                            <thead class="bg-body-secondary">
                                <tr class="small text-muted">
                                    <th class="ps-3">Ders</th>
                                    <th class="text-center">Doğru</th>
                                    <th class="text-center">Yanlış</th>
                                    <th class="text-center">Boş</th>
                                    <th class="text-center">Net</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in selectedExamDetail.Details)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@d.LessonName</td>
                                        <td class="text-center text-success">@d.Correct</td>
                                        <td class="text-center text-danger">@d.Wrong</td>
                                        <td class="text-center text-warning">@(d.Empty == 0 ? "-" : d.Empty)</td>
                                        <td class="text-center fw-bold text-primary">@d.Net.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-primary px-4 shadow-sm" @onclick="CloseModal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    [data-bs-theme="dark"] .bg-input-custom {
        background-color: #2b3035 !important;
        color: white;
    }

    [data-bs-theme="light"] .bg-input-custom {
        background-color: #f8f9fa !important;
        color: #212529;
    }

    [data-bs-theme="dark"] .bg-card-custom {
        background-color: #212529;
    }

    [data-bs-theme="light"] .bg-card-custom {
        background-color: #ffffff;
    }

    .table-responsive::-webkit-scrollbar {
        width: 6px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #6c757d;
        border-radius: 10px;
    }
</style>

@code {
    private CreateUserMockExamCommand newExam = new();
    private List<UserMockExamResponse>? examHistory;
    private UserMockExamDetailResponse? selectedExamDetail;

    private List<LessonDto> availableLessons = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableLessons();
        await InitializeNewExam();
        await LoadHistory();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (examHistory != null && examHistory.Any())
        {
            // Grafik çizimi
            var labels = examHistory.OrderBy(x => x.ExamDate).Select(x => x.ExamDate.ToShortDateString()).ToArray();
            var data = examHistory.OrderBy(x => x.ExamDate).Select(x => x.TotalNet).ToArray();
            
            // chartHelper.js içindeki fonksiyonu çağır
            await JS.InvokeVoidAsync("drawLineChart", "netChart", labels, data, "Net Gelişimi");
        }
    }

    private async Task LoadAvailableLessons()
    {
        var response = await LessonService.GetAll();
        availableLessons = response?.ToList() ?? new();
    }
    private string GetLessonExamQuestionCount(int lessonId)
    {
        return availableLessons.FirstOrDefault(x => x.Id == lessonId)?.ExamQuestionCount.ToString()?? "0";
    }

    private async Task InitializeNewExam()
    {
        newExam = new CreateUserMockExamCommand
        {
            ExamDate = DateTime.Now,
            ExamId = 1,
            Details = availableLessons.Select(l => new MockExamDetailDto
            {
                LessonId = l.Id
            }).ToList()
        };
    }

    private async Task LoadHistory()
    {
        examHistory = await MockService.GetUserMockExamsAsync();
    }
    
    private double CalculateEstimatedNet()
    {
        // 4 Yanlış 1 Doğruyu götürür kuralı varsayımıyla anlık hesaplama
        return newExam.Details.Sum(d => d.CorrectCount - (d.WrongCount * 0.25));
    }

    private async Task HandleCreateExam()
    {
        foreach (var detail in newExam.Details)
        {
            var lesson = availableLessons.FirstOrDefault(x => x.Id == detail.LessonId);
            if (lesson != null)
            {
                if ((detail.CorrectCount + detail.WrongCount) > lesson.ExamQuestionCount)
                {
                    await JS.InvokeVoidAsync("showToast", "error", $"{lesson.Name} dersinde soru limiti ({lesson.ExamQuestionCount}) aşıldı!");
                    return;
                }
            }
        }

        // Her şey tamamsa API'ye gönder
        var resultId = await MockService.CreateMockExamAsync(newExam);
        if (resultId > 0)
        {
            await InitializeNewExam();
            await LoadHistory();
            await JS.InvokeVoidAsync("showToast", "success", "Deneme sınavı başarıyla kaydedildi.");
        }
    }

    private async Task ShowDetail(int id)
    {
        selectedExamDetail = await MockService.GetMockExamDetailAsync(id);
    }

    private void CloseModal()
    {
        selectedExamDetail = null;
    }

    private string GetLessonName(int lessonId)
    {
        return availableLessons.FirstOrDefault(x => x.Id == lessonId)?.Name ?? $"Ders #{lessonId}";
    }
}