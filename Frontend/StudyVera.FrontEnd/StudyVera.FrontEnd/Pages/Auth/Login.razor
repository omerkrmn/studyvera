@page "/auth/login"
@using StudyVera.FrontEnd.Models.Auth
@using StudyVera.FrontEnd.Services.Concrats
@using StudyVera.FrontEnd.Utilities
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Giriş Yap</PageTitle>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 400px; background-color: var(--bs-body-bg);">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Hoş Geldiniz</h2>
            <p class="text-secondary small">Lütfen hesabınıza giriş yapın</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText @bind-Value="loginModel.Email" class="form-control" id="emailInput" placeholder="name@example.com" />
                <label for="emailInput">Email Adresi</label>
                <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
            </div>

            <div class="form-floating mb-3">
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control" id="passInput" placeholder="Şifre" />
                <label for="passInput">Şifre</label>
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span> <span>Giriş Yapılıyor...</span>
                }
                else
                {
                    <span>Giriş Yap</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 small py-2 rounded-3 border-0 shadow-sm text-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                </div>
            }
        </EditForm>
        
        <div class="text-center mt-4">
            <p class="small text-secondary">Hesabınız yok mu? <a href="/auth/register" class="text-primary text-decoration-none fw-bold">Kayıt Ol</a></p>
        </div>

        <div class="position-relative my-3">
            <hr class="text-secondary" />
            <span class="position-absolute top-50 start-50 translate-middle bg-body px-3 text-secondary small">veya</span>
        </div>

        <div class="d-grid">
            <div id="googleSignInDiv" class="d-flex justify-content-center"></div>
        </div>
        @if (!string.IsNullOrEmpty(googleErrorMessage))
        {
            <div class="alert alert-danger mt-3 small py-2 rounded-3 border-0 shadow-sm text-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @googleErrorMessage
            </div>
        }
    </div>
</div>

@code {
    private string? googleErrorMessage;
    private DotNetObjectReference<Login>? dotNetHelper;

    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private string? errorMessage;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var success = await AuthService.Login(loginModel);

        if (success)
            Navigation.NavigateTo("/profile");
        else
            errorMessage = "E-posta adresi veya şifre hatalı.";
        isLoading = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
            string clientId = AppConsts.GoogleClientId;
            if (string.IsNullOrEmpty(clientId))
            {
                googleErrorMessage = "Google Client ID yapılandırılmamış.";
                return;
            }
            await JSRuntime.InvokeVoidAsync("googleAuth.initializeGoogleSignIn", dotNetHelper, clientId);
            await JSRuntime.InvokeVoidAsync("googleAuth.renderButton", "googleSignInDiv");
        }
    }
    [JSInvokable]
    public async Task HandleCredentialResponse(string credential)
    {
        googleErrorMessage = null;
        StateHasChanged();

        var success = await AuthService.GoogleLogin(credential);
        if (success)
            Navigation.NavigateTo("/profile", true);
        else
            googleErrorMessage = "Google ile giriş başarısız oldu. Lütfen tekrar deneyin.";
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}